{
  "name": "ocr-extractor",
  "version": "2.4.2",
  "description": "Obsidian plugin to extract text from PDFs, documents, images, etc. with OCR and store it as Markdown in notes",
  "main": "main.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest",
    "test:e2e": "playwright test --config e2e-tests/playwright.config.ts --project=latest",
    "test:e2e:all": "playwright test --config e2e-tests/playwright.config.ts",
    "latest-obsidian": "node scripts/latest-obsidian.mjs",
    "generate-licenses": "node scripts/generate-licenses.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "version": "node scripts/version-bump.mjs"
  },
  "keywords": [],
  "author": "Johnathan Ritzi",
  "license": "MIT",
  "dependencies": {
    "@mistralai/mistralai": "^2.6.4",
    "clsx": "^2.1.1",
    "file-type": "^22.0.2",
    "i18next": "^26.4.0",
    "motion": "^13.1.1",
    "openai": "^6.42.0",
    "p-limit": "^7.3.1",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semver": "^7.8.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "@eslint/config-helpers": "^0.7.0",
    "@eslint/js": "^9.39.2",
    "@mswjs/interceptors": "^0.42.3",
    "@playwright/test": "^1.62.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/semver": "^7.8.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "generate-license-file": "^4.2.5",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "obsidian": "^1.12.3",
    "ocr-extractor-api": "workspace:*",
    "prettier": "3.9.6",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
